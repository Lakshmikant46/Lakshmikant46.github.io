source "https://rubygems.org"

# Matches what GitHub Pages runs, so your local preview equals the live site.
# This lets GitHub build the site natively — no GitHub Actions to maintain.
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` locally on Ruby 3.0+ (WEBrick is no longer bundled).
gem "webrick", "~> 1.8"
